# Database (Supabase session pooler connection string)
DATABASE_URL=

# Auth
SECRET_KEY=

# Email (Brevo)
BREVO_API_KEY=
EMAIL_FROM_AUTH=
EMAIL_FROM_SUPPORT=
FRONTEND_URL=

# Audio storage (Backblaze B2)
B2_ENDPOINT_URL=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_UPLOAD_URL_EXPIRY_SECONDS=900
B2_DOWNLOAD_URL_EXPIRY_SECONDS=3600

# Image storage (Supabase Storage). Server-side only: the secret key must never reach the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_IMAGE_BUCKET=

# Login rate limiting (in-memory fallback when REDIS_URL is unset)
REDIS_URL=
LOGIN_MAX_ATTEMPTS_PER_ID=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=900